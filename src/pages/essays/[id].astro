---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { typedDate } from '../../site';

export async function getStaticPaths() {
  const essays = await getCollection('essays', ({ data }) => !data.draft);
  return essays.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<'essays'> };
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.standfirst}>
  <article>
    <h1 class="essay__title">{entry.data.title}</h1>
    {
      entry.data.standfirst && (
        <p class="essay__standfirst">{entry.data.standfirst}</p>
      )
    }
    <p class="essay__date">
      {typedDate(entry.data.date)}
      {entry.data.series && <>, from {entry.data.series}</>}
    </p>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
