---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { typedDate } from '../../site';

const fragments = (
  await getCollection('fragments', ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const rendered = await Promise.all(
  fragments.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  }))
);
---

<Base title="fragments" description="short pieces, newest first.">
  {
    rendered.map(({ entry, Content }) => (
      <section class="fragment">
        <span class="fragment__date">{typedDate(entry.data.date)}</span>
        {entry.data.title && <h2 class="fragment__title">{entry.data.title}</h2>}
        <div class="prose">
          <Content />
        </div>
      </section>
    ))
  }
</Base>
