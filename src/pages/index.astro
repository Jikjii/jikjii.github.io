---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site, href, year } from '../site';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base>
  <p class="epigraph">{site.epigraph}</p>

  <ul class="toc">
    {
      essays.map((entry) => (
        <li>
          <a class="toc__title" href={href(`/essays/${entry.id}`)}>
            {entry.data.title}
          </a>
          <span class="toc__leader" aria-hidden="true" />
          <span class="toc__year">{year(entry.data.date)}</span>
        </li>
      ))
    }
  </ul>
</Base>
